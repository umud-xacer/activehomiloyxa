# deployment/env/.env.local.example -- Local Development (Infra Sec 17).
# Copy to .env.local (gitignored) and adjust. Matches deployment/compose/docker-compose.yml
# defaults so `docker compose up` and the app agree without edits.
#
# Two kinds of config (Infra Sec 11) -- do not conflate them:
#   1. Infrastructure/runtime settings (this file): non-secret, twelve-factor style.
#   2. Business/platform config (categories, forms, plans, roles, ...): NOT here -- that is
#      versioned data owned by the `configuration` module (DEC-21), never an env var.

ENV_NAME=local
LOG_LEVEL=debug

# -- CORS (frontend dev server and API run on different ports/origins) --
# :3000 is `next dev`'s own default port; :8080 is nginx's (Infra Sec 6). Both are needed since
# apps/frontend/next.config.ts's dev rewrite makes the browser call the API through :3000
# first-party, but the frontend's server-side (RSC) fetches and any direct :8080 access still
# need CORS allowed too.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:8080,http://localhost:8080

# -- PostgreSQL (single source of truth; one schema per module, Infra Sec 3) --
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=active_home
POSTGRES_USER=active_home
POSTGRES_PASSWORD=active_home_local_dev_only

# -- Redis (cache/sessions/rate-limits/config snapshots/chat pub-sub) --
REDIS_HOST=localhost
REDIS_PORT=6379

# -- OpenSearch (search read model; populated only by the indexing worker) --
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200

# -- MinIO (object storage; images only, DEC-10) --
MINIO_ENDPOINT=localhost:9000
# Public base URL for presigned upload URLs handed to a real browser -- same as MINIO_ENDPOINT
# locally, NOT the same in production (see object_storage.py's MinioStorageAdapter comment).
MINIO_PUBLIC_ENDPOINT_URL=http://localhost:9000
MINIO_ROOT_USER=active_home
MINIO_ROOT_PASSWORD=active_home_local_dev_only
MINIO_MEDIA_BUCKET=active-home-media
MINIO_USE_TLS=false

# -- Media delivery + intake pipeline (BC-06, Task P-06) --
# Points straight at MinIO, not through nginx on :8080: nginx's own config is still a health-check
# skeleton (Infra Sec 5/Sec 6 TODO -- no real /media/* reverse-proxy block exists yet), so a
# CDN base URL routed through it 503s. Direct-to-MinIO is the only local path that resolves.
MEDIA_CDN_BASE_URL=http://127.0.0.1:9000/active-home-media
MEDIA_PRESIGN_EXPIRY_SECONDS=900
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# -- Session auth (server-side sessions in Redis, not JWT) --
SESSION_COOKIE_NAME=ah_session
SESSION_SIGNING_KEY=CHANGE_ME_IN_SECRETS_STORE

# -- Fixed external providers (DEC-18), only adapters hold these credentials --
ESKIZ_API_BASE_URL=https://notify.eskiz.uz/api
ESKIZ_EMAIL=CHANGE_ME_IN_SECRETS_STORE
ESKIZ_PASSWORD=CHANGE_ME_IN_SECRETS_STORE
ESKIZ_SENDER_NICKNAME=CHANGE_ME_IN_SECRETS_STORE
GOOGLE_OAUTH_CLIENT_ID=CHANGE_ME_IN_SECRETS_STORE
GOOGLE_OAUTH_CLIENT_SECRET=CHANGE_ME_IN_SECRETS_STORE

# -- Notifications channels (Notifications module, template-based delivery) --
# Email registration/OTP needs a real SMTP STARTTLS+AUTH handshake -- a local Mailpit
# (`docker run -e MP_SMTP_AUTH_ACCEPT_ANY=1 -e MP_SMTP_AUTH_ALLOW_INSECURE=1 -e
# MP_SMTP_TLS_CERT=/certs/cert.pem -e MP_SMTP_TLS_KEY=/certs/key.pem -p 1025:1025 -p 8025:8025
# axllent/mailpit`, any self-signed cert) satisfies it; view sent mail at :8025. Phone OTP still
# needs real Eskiz creds (below), so email is the only auth path usable purely locally.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=dev
SMTP_PASSWORD=dev
WEB_PUSH_VAPID_PUBLIC_KEY=CHANGE_ME_IN_SECRETS_STORE
WEB_PUSH_VAPID_PRIVATE_KEY=CHANGE_ME_IN_SECRETS_STORE
