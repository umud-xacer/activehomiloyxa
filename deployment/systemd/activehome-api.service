[Unit]
Description=ActiveHome backend (FastAPI/uvicorn)
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/app/apps/backend/src
EnvironmentFile=/home/ubuntu/app/deployment/env/.env.production
Environment=PYTHONPATH=/home/ubuntu/app/apps/backend/src:/home/ubuntu/app/packages/shared/src:/home/ubuntu/app
ExecStart=/home/ubuntu/app/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
