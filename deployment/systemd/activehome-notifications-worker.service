[Unit]
Description=ActiveHome notifications worker (drains profiles/identity outbox projections)
After=network.target docker.service activehome-api.service
Requires=docker.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/app/apps/backend/src
EnvironmentFile=/home/ubuntu/app/deployment/env/.env.production
Environment=PYTHONPATH=/home/ubuntu/app/apps/backend/src:/home/ubuntu/app/packages/shared/src:/home/ubuntu/app
ExecStart=/home/ubuntu/app/.venv/bin/python3 -m notifications_worker
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
