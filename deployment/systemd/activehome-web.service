[Unit]
Description=ActiveHome frontend (TanStack Start / Node)
After=network.target activehome-api.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/app/apps/frontend
Environment=PORT=3000
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /home/ubuntu/app/apps/frontend/.output/server/index.mjs
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
