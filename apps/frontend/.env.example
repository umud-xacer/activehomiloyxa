# Backend API (apps/backend). The /api/v1 prefix is appended automatically
# by src/lib/http.ts — do not include it here.
VITE_API_BASE_URL="http://localhost:8000"

# Yandex Maps JavaScript API key — powers every map surface in the app
# (src/lib/yandex-maps.ts / src/components/map/YandexMapView.tsx): the map
# itself, the Geocoder (search box, forward/reverse geocoding), and
# multiRouter (driving/walking/transit routing + live navigation) all read
# this ONE key — Yandex's JS API bundles all three under a single "JavaScript
# API and HTTP Geocoder" key from https://developer.tech.yandex.ru/services
# (free tier). Must be allow-listed for both your production domain and
# localhost. Until this is set, every map on the site renders a
# "Xarita sozlanmagan" placeholder instead of crashing the page.
VITE_YANDEX_MAPS_API_KEY=""

# Google Sign-In (OAuth 2.0 Client ID, "Web application" type) from
# https://console.cloud.google.com/apis/credentials — Authorized redirect URI must include
# <your-origin>/auth/callback/google. Until this is set, the "Google bilan kirish" button shows
# an inline "sozlanmagan" notice instead of starting a broken redirect.
VITE_GOOGLE_OAUTH_CLIENT_ID=""

# Sign in with Apple (Services ID) from https://developer.apple.com/account/resources/identifiers
# (requires an enrolled Apple Developer Program membership) — the Services ID's configured return
# URL must be <your-origin>/auth/callback/apple (backend's form_post relay, see
# identity/interfaces/routers.py). Until this is set, the "Apple bilan kirish" button shows an
# inline "sozlanmagan" notice instead of starting a broken redirect.
VITE_APPLE_CLIENT_ID=""

# ADR-0010: Payme/Click checkout. Merchant/service IDs are NOT secret (they travel in plain sight
# inside every checkout URL) -- the real secret (PAYME_SECRET_KEY/CLICK_SECRET_KEY, used to verify
# webhook signatures) lives server-side only, in deployment/env/.env.*, never here.
# Payme merchant cabinet (https://business.payme.uz) -- "Kassa" -> Merchant ID.
VITE_PAYME_MERCHANT_ID=""
# Click merchant cabinet (https://merchant.click.uz) -- Service ID.
VITE_CLICK_SERVICE_ID=""
# Click merchant cabinet -- Merchant ID (distinct from Service ID; both appear in the checkout
# URL/signed payload).
VITE_CLICK_MERCHANT_ID=""
