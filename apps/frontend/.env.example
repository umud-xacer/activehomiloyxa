# Backend API (apps/backend). The /api/v1 prefix is appended automatically
# by src/lib/http.ts — do not include it here.
VITE_API_BASE_URL="http://localhost:8000"

# Google Maps JavaScript API — browser key (HTTP-referrer restricted) used by
# src/lib/google-maps.ts / src/components/map/GoogleMapView.tsx.
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_BROWSER_KEY=""
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_TRACKING_ID=""

# Optional: Mapbox token for src/components/map/MapView.tsx (Mapbox variant).
# Falls back to a static illustrative map when unset.
VITE_MAPBOX_TOKEN=""
