# Backend API (apps/backend). The /api/v1 prefix is appended automatically
# by src/lib/http.ts — do not include it here.
VITE_API_BASE_URL="http://localhost:8000"

# Yandex Maps JavaScript API key — powers every map surface in the app
# (src/lib/yandex-maps.ts / src/components/map/YandexMapView.tsx): the map
# itself, the Geocoder (search box, forward/reverse geocoding), and
# multiRouter (driving/walking/transit routing + live navigation) all read
# this ONE key — Yandex's JS API bundles all three under a single "JavaScript
# API and HTTP Geocoder" key from https://developer.tech.yandex.ru/services
# (free tier). Must be allow-listed for both your production domain and
# localhost. Until this is set, every map on the site renders a
# "Xarita sozlanmagan" placeholder instead of crashing the page.
VITE_YANDEX_MAPS_API_KEY=""
